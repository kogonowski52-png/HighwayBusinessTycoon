config_version=5

[application]
config/name="Highway Business Tycoon"
config/version="0.8.0"
config/icon="res://assets/icons/app.svg"
run/main_scene="res://scenes/ui/front_gate.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

RouteAudio="*res://scripts/audio/soundscape.gd"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/16_bits.mobile=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.72, 0.8, 0.72, 1)

[shader_globals]

hbt_practical_level={
"type": "float",
"value": 0.22
}
hbt_ambient_motion={
"type": "float",
"value": 1.0
}

[editor_plugins]

enabled=PackedStringArray("res://addons/highway_rewarded/plugin.cfg")
